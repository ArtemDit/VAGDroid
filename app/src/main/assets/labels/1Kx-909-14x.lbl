;
;
001,1,Temperature,Output Stage
001,2,Steering Torque,(G269)
001,3,Rotor Speed,of Power Steering
;
002,1,Relay Voltage
002,2,Battery Voltage,(Terminal 30)
002,3,Sensor Supply,(G269)
002,4,Battery since,Term. 30 Recogn.,Display Range: on/off
;
003,1,Vehicle,Engine Speed
003,2,Vehicle Speed,,Display Range: on/off
003,3,Engine,running,Display Range: on/off
;
004,1,System Status,,Display Range: 0 = Off/1 = Init/2 = Power up/3 = Normal/4 = Power down/5 = Post run/6 = Error
004,2,Status,Terminal 15
004,3,Relay Condition
;
005,1,Torque,Assistance
005,2,Limited Torque,Assistance
005,3,Torque,Engine
005,4,Torque,Stabilizer
;
006,1,Temperature,Output Stage
006,2,Actuator
006,3,End Impact
006,4,Angle,Straight Ahead
;
007,0,Steering Angle Sensor
007,1,Steering Angle
007,2,Angular,Acceleration
007,3,Basic Setting,Condition,Display Range: OK/not OK/Reading impossible
007,4,Initialization,,Display Range: started/not started/implausible
;
125,0,CAN-Databus Powertrain (Communication)
125,1,Brake Electronics,(J104)
125,2,Engine
125,3,Central Electronics,(J519)
;
