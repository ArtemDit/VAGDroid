;
; Adaptation informations
;
;---------------------------------------------------
;
;
A3,0,Consumption correction
A3,5,Consumption correction
A3,6,85...115 % (in 5% increments)
;
A4,0,Language variants
A4,5,Language variants
A4,6,1 - German
A4,7,2 - English
A4,8,3 - French
A4,9,4 - Italian
A4,10,5 - Spanish
A4,11,6 - Portuguese
A4,12,8 - Chinese
;
A9,0,Mileage
A9,5,Mileage
A9,6,km/miles reading
A9,7,Resolution: 0.01
;
A18,0,Auxiliary heating
A18,5,Auxiliary heating
A18,6,0 - no auxiliary heating installed
A18,7,1 - Auxiliary heating installed
A18,8,2 - Auxiliary heating installed and goes out when turning engine off
A18,9,3 - only auxiliary ventilation
A18,10,4 - only auxiliary ventilation and goes out when turning engine off
;
A19,0,Additional features
A19,5,Additional features
A19,6,?xxxx - Illumination option
A19,7,0 - Needle and scala only active at 'Light on"
A19,8,1 - Needle already active at 'Ignition on'
A19,9,2 - Scale already active at 'Ignition on'
A19,10,3 - Scala (2. map) and needle at "ignition on" active
A19,11, 
A19,12,x?xxx - Board computer
A19,13,0 - only level 2 (long time memory)
A19,14,1 - level 1 and 2
A19,15, 
A19,16,xx?xx - Driver Information System (DIS)
A19,17,0 - DIS 1 / 1 - Highline without DIS / 2 - DIS 2
A19,18, 
A19,19,xxx?x - Outside temperature
A19,20,0 - no display, illumination goes out
A19,21,1 - Display and illumination active
A19,22, 
A19,23,xxxx? - Remote clock
A19,24,0 - Remote clock not active / 1 - Remote clock active
;
