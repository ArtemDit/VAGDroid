;
; VAG-COM Labelfile
;
; Audi A3 (8L) / VW Golf IV (1J) / VW New Beetle (1C/9C/1Y)
;
; Component: J104 - Brake Electronics (#03) - MK60 ESP AWD
;
; P/N: 1C0-907-37?-???
;
; includes measuring blocks
;
; This file is part of a redirection package,
; make sure you have all of the following files.
;
; 1C-03.LBL
; 1C0-907-37x-ABS.LBL
; 1C0-907-37x-ASR.LBL
; 1C0-907-37x-ESP-A.LBL
; 1C0-907-37x-ESP-F.LBL
;
; created on 10/Jan/2005 by Sebastian Stange (sebastian@ross-tech.com)
;
; last modification: 12/Dec/2005
;
; requires VAG-COM 405.0 or newer
;
;
;---------------------------------------------------
;
; measuring block information
;
;---------------------------------------------------
;
;
001,0,Current Wheel Speed (Basic Setting: Brake Pump Bleeding)
001,1,Speed Sensor,Front Left (G47),Specification: 0.0...255.0 km/h
001,2,Speed Sensor,Front Right (G45),Specification: 0.0...255.0 km/h
001,3,Speed Sensor,Rear Left (G46),Specification: 0.0...255.0 km/h
001,4,Speed Sensor,Rear Right (G44),Specification: 0.0...255.0 km/h
;
002,0,Starting Wheel Speed
002,1,Speed Sensor,Front Left (G47),Specification: 0.0...254.0 km/h (255.0 km/h = standing)
002,2,Speed Sensor,Front Right (G45),Specification: 0.0...254.0 km/h (255.0 km/h = standing)
002,3,Speed Sensor,Rear Left (G46),Specification: 0.0...254.0 km/h (255.0 km/h = standing)
002,4,Speed Sensor,Rear Right (G44),Specification: 0.0...254.0 km/h (255.0 km/h = standing)
;
003,0,Switches and Warning Lights
003,1,Brake Light,Switch (F),Specification: not oper./operated
003,2,Brake System,Warning Light,Specification: on/off
003,3,ABS,Warning Light,Specification: on/off
003,4,ASR/ESP,Warning Light,Specification: on/off
;
004,0,Steering Angle / Lateral Acceleration / Rotation Rate
004,1,Steering Angle,Sensor (G85),Specification: ± 4.5 °
004,2,Lateral,Acceleration,Specification: ± 1.5 m/s²
004,3,Rotation Rate,,Specification: ± 2.5 °/s
;
005,0,Brake Pressure
005,1,Brake Pressure,Sensor,Specification: ±7 bar
;
006,0,Longitudinal Acceleration
006,1,Longitudinal,Acc. Sensor,Specification: ±1.5 m/s²
;
040,0,Basic Setting: Deactivation of Longitudinal Acceleration Sensor (G251)
;
060,0,Basic Setting: Zero Adjustment of Steering Angle Sensor (G85)
;
063,0,Basic Setting: Zero Adjustment of Lateral Acceleration Sensor (G200)
;
066,0,Basic Setting: Zero Adjustment of Brake Pressure Sensor (G201)
;
069,0,Basic Setting: Zero Adjustment of Longitudinal Acceleration Sensor (G251)
;
093,0,Basic Setting: Driving Test
;
080,0,Advanced Control Module Identification I
;
125,0,CAN-Databus Communication (Powertrain)
125,1,Engine
125,2,Steering Angle
125,3,All Wheel Drive
125,4,Transmission
;
